# Normalize line endings to LF in the repository; checkout as CRLF on Windows
* text=auto eol=lf

# Windows-only scripts — keep CRLF on checkout
*.bat text eol=crlf
*.iss text eol=crlf
*.ps1 text eol=crlf

# Binary files — no line-ending conversion
*.ico binary
*.png binary
*.jpg binary
*.exe binary
*.dll binary
*.pyd binary
