*.log
.env
.env.*

# IDE / editor settings (machine-specific)
.claude/
.vscode/
.idea/
*.swp
*.swo

# Virtual environments
.venv/
venv/
env/
ENV/

# Windows artifacts
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Test / lint cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# macOS
.DS_Store
